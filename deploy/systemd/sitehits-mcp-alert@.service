[Unit]
Description=Send SiteHits MCP Stage 1 alert for %i

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
ExecStart=/srv/apps/sitehits/venv/bin/python /srv/apps/sitehits/deploy/send-mcp-alert.py %i
NoNewPrivileges=true
PrivateTmp=true
