[Unit]
Description=SiteHits daily MCP/OAuth and audit metadata cleanup
After=postgresql.service
OnFailure=sitehits-mcp-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
Environment=HOME=/home/ubuntu
ExecStart=/srv/apps/sitehits/venv/bin/python manage.py cleanup_mcp_oauth --batch-size 500 --max-batches 20
ExecStart=/srv/apps/sitehits/venv/bin/python manage.py purge_old_events
NoNewPrivileges=true
PrivateTmp=true
