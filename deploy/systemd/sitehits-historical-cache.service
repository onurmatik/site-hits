[Unit]
Description=Refresh SiteHits historical analytics cache
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
Environment=HOME=/home/ubuntu
ExecStart=/srv/apps/sitehits/venv/bin/python manage.py refresh_historical_reports
NoNewPrivileges=true
PrivateTmp=true
