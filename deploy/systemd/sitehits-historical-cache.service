[Unit]
Description=Refresh SiteHits historical analytics cache
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=sitehits-mcp-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
ExecStartPre=/srv/apps/sitehits/deploy/validate-image-ref.sh
ExecStart=/usr/bin/docker run --rm --network host --env-file /srv/apps/sitehits/.env --read-only --tmpfs /tmp:rw,noexec,nosuid,size=768m --cap-drop ALL --security-opt no-new-privileges --mount type=bind,src=/var/lib/GeoIP/GeoLite2-City.mmdb,dst=/var/lib/GeoIP/GeoLite2-City.mmdb,readonly ${SITEHITS_MCP_IMAGE_REF} python manage.py refresh_historical_reports
NoNewPrivileges=true
PrivateTmp=true
