[Unit]
Description=Check SiteHits MCP/OAuth cleanup health
After=postgresql.service
OnFailure=sitehits-mcp-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
Environment=HOME=/home/ubuntu
ExecStart=/srv/apps/sitehits/venv/bin/python manage.py check_mcp_oauth_cleanup_health
NoNewPrivileges=true
PrivateTmp=true
