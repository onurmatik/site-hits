[Unit]
Description=SiteHits dedicated MCP resource process (native checkout)
After=network-online.target postgresql.service app@sitehits.socket
Wants=network-online.target
ConditionPathExists=/srv/apps/sitehits/venv/bin/python

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
Environment=PATH=/srv/apps/sitehits/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ubuntu
ExecStart=/bin/sh /srv/apps/sitehits/scripts/start.sh mcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
