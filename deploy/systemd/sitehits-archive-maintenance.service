[Unit]
Description=SiteHits verified analytics archive maintenance
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/apps/sitehits
EnvironmentFile=/srv/apps/sitehits/.env
Environment=HOME=/home/ubuntu
ExecStart=/srv/apps/sitehits/venv/bin/python manage.py maintain_event_archive --limit 12
NoNewPrivileges=true
PrivateTmp=true
