DJANGO_DEBUG=false
SITEHITS_ALLOW_UNRELEASED_AGENT_CONTRACT=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# Required for Stage 1 production: PostgreSQL 17.
DATABASE_URL=postgresql://sitehits:password@127.0.0.1:5432/sitehits
ALLOWED_HOSTS=sitehits.io
CSRF_TRUSTED_ORIGINS=https://sitehits.io
SITEHITS_BASE_URL=https://sitehits.io
SITEHITS_HASH_SECRET=replace-with-an-independent-long-random-value
SITEHITS_GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
SITEHITS_TIME_ZONE=Europe/Istanbul
SITEHITS_TRUST_PROXY_HEADERS=true
SITEHITS_TRUSTED_PROXY_IPS=127.0.0.1,::1
SITEHITS_MAX_EVENT_BYTES=16384

# Historical analytics archive. Enable export first in shadow mode; only turn
# source deletion and dashboard queries on after archive verification is green.
SITEHITS_ARCHIVE_ENABLED=false
SITEHITS_ARCHIVE_DELETE_SOURCE=false
SITEHITS_ARCHIVE_QUERY_ENABLED=false
SITEHITS_ARCHIVE_BUCKET=sitehits-analytics-archive
SITEHITS_ARCHIVE_PREFIX=sitehits
SITEHITS_ARCHIVE_REGION=eu-central-1
# Optional for local S3-compatible integration tests (for example MinIO).
SITEHITS_ARCHIVE_ENDPOINT=
SITEHITS_ARCHIVE_KMS_KEY_ID=
SITEHITS_ARCHIVE_HOT_DAYS=90
SITEHITS_ARCHIVE_QUERYABLE_DAYS=730
SITEHITS_ARCHIVE_RETENTION_DAYS=1095
SITEHITS_HISTORICAL_CACHE_SECONDS=3600
SITEHITS_HISTORICAL_QUERY_TIMEOUT_SECONDS=15
SITEHITS_HISTORICAL_QUERY_CONCURRENCY=1

# Independent HMAC key for OAuth security-event and rate-limit pseudonyms.
# OAuth credentials use one-way SHA-256 digests and do not depend on this key.
SITEHITS_MCP_TOKEN_SECRET=replace-with-an-independent-long-random-value
SITEHITS_MCP_ISSUER_URL=https://sitehits.io
SITEHITS_MCP_RESOURCE_URL=https://sitehits.io/mcp
SITEHITS_MCP_DOCUMENTATION_URL=https://sitehits.io/mcp-docs/
SITEHITS_MCP_SKILL_UPDATE_URL=https://sitehits.io/INSTALL.md
SITEHITS_MCP_HOST=127.0.0.1
SITEHITS_MCP_PORT=8001
# Explicit browser origins accepted by the dedicated MCP process. Wildcards are
# rejected in production. OAuth metadata has its own public `*` response policy.
SITEHITS_MCP_CORS_ORIGINS=https://chatgpt.com,https://codex.openai.com
# OAuth lifetimes are fixed by the Stage 1 contract: code 60 seconds, access
# token 15 minutes, and absolute refresh family 30 days.

# Required for AI-assisted Product metrics planning. The model, timeout, and
# per-session hourly draft limit are optional operational overrides.
OPENAI_API_KEY=
SITEHITS_GOAL_PLANNING_MODEL=gpt-5.6-sol
SITEHITS_GOAL_PLANNING_TIMEOUT_SECONDS=30
SITEHITS_GOAL_PLANNING_RATE_LIMIT=10

# Required in production. Google OAuth web application. Add this exact
# authorized redirect URI:
# https://sitehits.io/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Local development defaults to Django's console backend. Production defaults
# to the SES API backend and requires dedicated SES IAM credentials. The region
# must match the region where the sitehits.io identity is verified.
DJANGO_EMAIL_BACKEND=django_ses.SESBackend
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=
# Optional; derived as email.<region>.amazonaws.com when omitted.
AWS_SES_REGION_ENDPOINT=
USE_SES_V2=true
# Optional SES configuration set for delivery/bounce monitoring.
AWS_SES_CONFIGURATION_SET=
DEFAULT_FROM_EMAIL=SiteHits <hello@sitehits.io>
