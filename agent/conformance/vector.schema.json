{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitehits.io/schemas/agent-contract-vector-1.json",
  "type": "object",
  "required": ["schema_version", "id", "agent_contract_version", "tool", "defaults", "execution_coverage", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "agent_contract_version": {"const": "1.0.0"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "defaults": {
      "type": "object",
      "required": ["context", "authorization_context", "audit"],
      "properties": {
        "context": {"$ref": "#/$defs/context"},
        "authorization_context": {"$ref": "#/$defs/authorization"},
        "audit": {"$ref": "#/$defs/audit"}
      },
      "additionalProperties": false
    },
    "execution_coverage": {
      "type": "object",
      "required": [
        "success",
        "invalid_input",
        "missing_capability",
        "ownership_isolation",
        "capability_plan_matrix",
        "quota_concurrency",
        "idempotent_replay",
        "idempotency_conflict",
        "approval",
        "uncertain_external_effect",
        "redaction",
        "async_status",
        "internal_error"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "basis", "tests"],
        "properties": {
          "mode": {"enum": ["per_tool_vector", "shared_service_mechanism", "contract_inapplicability"]},
          "basis": {"type": "string", "minLength": 12},
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^tests/test_agent_runtime.py::test_[a-z0-9_]+$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "object",
      "required": [
        "success",
        "invalid_input",
        "missing_capability",
        "ownership_isolation",
        "capability_plan_matrix",
        "quota_concurrency",
        "idempotent_replay",
        "idempotency_conflict",
        "approval",
        "uncertain_external_effect",
        "redaction",
        "async_status",
        "internal_error"
      ],
      "properties": {
        "success": {"$ref": "#/$defs/scenario"},
        "invalid_input": {"$ref": "#/$defs/scenario"},
        "missing_capability": {"$ref": "#/$defs/scenario"},
        "ownership_isolation": {"$ref": "#/$defs/scenario"},
        "capability_plan_matrix": {"$ref": "#/$defs/scenario"},
        "quota_concurrency": {"$ref": "#/$defs/scenario"},
        "idempotent_replay": {"$ref": "#/$defs/scenario"},
        "idempotency_conflict": {"$ref": "#/$defs/scenario"},
        "approval": {"$ref": "#/$defs/scenario"},
        "uncertain_external_effect": {"$ref": "#/$defs/scenario"},
        "redaction": {"$ref": "#/$defs/scenario"},
        "async_status": {"$ref": "#/$defs/scenario"},
        "internal_error": {"$ref": "#/$defs/scenario"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "context": {
      "type": "object",
      "required": ["authenticated_actor_id", "authenticated_client_id", "tenant_id"],
      "properties": {
        "authenticated_actor_id": {"type": "string", "minLength": 1},
        "authenticated_client_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "null"},
        "ownership": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["authenticated", "scopes", "capabilities", "limits"],
      "properties": {
        "authenticated": {"type": "boolean"},
        "scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "limits": {"type": "object", "additionalProperties": true},
        "plan_label": {"type": "string"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["profile", "input_recording", "required_fields", "forbidden_fields"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "input_recording": {"const": "keyed_hash"},
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["outcome", "audit_outcome_code"],
      "properties": {
        "outcome": {"enum": ["success", "error", "matrix", "concurrent_results"]},
        "result_schema_ref": {"type": "string"},
        "error_code": {"type": "string"},
        "audit_outcome_code": {"type": "string"},
        "assertions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cases": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "results": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "applicable": {
      "type": "object",
      "required": ["applicable", "input", "expected"],
      "properties": {
        "applicable": {"const": true},
        "input": {"type": "object"},
        "context_override": {"type": "object", "additionalProperties": true},
        "authorization_override": {"type": "object", "additionalProperties": true},
        "expected": {"$ref": "#/$defs/expected"},
        "audit_override": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "not_applicable": {
      "type": "object",
      "required": ["applicable", "reason"],
      "properties": {
        "applicable": {"const": false},
        "reason": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    },
    "scenario": {"oneOf": [{"$ref": "#/$defs/applicable"}, {"$ref": "#/$defs/not_applicable"}]}
  }
}
